
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Neon: the "-pooler" host with ?pgbouncer=true)
  directUrl = env("DIRECT_URL")   // direct connection, used by migrations
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  refresh_token_expires_in Int? // Google sends this; the adapter stores every token field
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  clips         Clip[]
  apiTokens     ApiToken[]
  chillPlaylistId String?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Clip {
  id          String   @id @default(cuid())
  trackUri    String
  trackName   String
  startTime   Int      // Start time in milliseconds
  endTime     Int      // End time in milliseconds
  artist      String?  // Channel / artist name (YouTube)
  imageUrl    String?  // Thumbnail URL
  durationMs  Int?     // Full track length, for slider bounds without loading the video
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Long-lived bearer tokens minted for the mobile app after a browser sign-in.
model ApiToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?

  @@index([userId])
}
