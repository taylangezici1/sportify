# PostgreSQL. Locally both are the same. On Neon use the pooled host for
# DATABASE_URL (add ?pgbouncer=true) and the direct host for DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spotify-clipper"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/spotify-clipper"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Google OAuth client (Web application). Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API v3 key (same Google Cloud project, API restricted to YouTube Data API v3)
YOUTUBE_API_KEY=
